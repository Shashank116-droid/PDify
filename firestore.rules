rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /pdfs/{pdfId} {
      // Allow create if user is authenticated and sets their own userId
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow read/update/delete if user owns the document
      allow read, update, delete: if resource.data.userId == request.auth.uid;
    }

    match /summaries/{summaryId} {
      // Allow read if authenticated
      allow read: if isAuthenticated(); 
      // Allow delete if the user owns the parent PDF
      allow delete: if isAuthenticated() 
        && get(/databases/$(database)/documents/pdfs/$(resource.data.pdfId)).data.userId == request.auth.uid;
    }
  }
}
